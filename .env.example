# Copy to .env. Compose works without it (defaults are dev-safe), but a real
# deployment must override every secret below.
ENV=dev

POSTGRES_USER=sehat
POSTGRES_PASSWORD=sehat
POSTGRES_DB=sehat
# 5432 is commonly taken by a local Postgres; the container publishes here.
POSTGRES_HOST_PORT=55432

# Non-owner role used by the API at runtime, so RLS policies apply.
APP_DB_ROLE=sehat_app
APP_DB_PASSWORD=sehat_app

MINIO_ROOT_USER=sehat
MINIO_ROOT_PASSWORD=sehat-secret
MINIO_BUCKET=sehat-bridge
MINIO_PUBLIC_URL=http://localhost:9000

SITE_URL=http://localhost:8080

# 32+ random bytes each, generated independently:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me
APP_ENCRYPTION_KEY=dev-only-change-me-32-bytes-minimum
SESSION_SECRET=dev-only-session-change-me

SATUSEHAT_MODE=mock